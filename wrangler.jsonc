{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dlicomgames",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/api/*", "/logout"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dlicomgames-db",
      "database_id": "881feb6d-11b0-4143-b43c-1f749e1f67fb"
    }
  ]
}
